package com.cdac.service;

import java.util.List;

import org.springframework.stereotype.Service;

import com.cdac.froms.WorkDetails;
import com.cdac.repository.WorkRepository;

@Service
public class WorkServiceImpl implements WorkService {

    private final WorkRepository workRepository;

    public WorkServiceImpl(WorkRepository workRepository) {
        this.workRepository = workRepository;
    }

    
    @Override
    public WorkDetails createWorkDetails(WorkDetails workDetails) {
        return workRepository.save(workDetails);
    }

    @Override
    public WorkDetails getWorkDetailsByWorkRegNo(Long workRegNo) {
        return workRepository.findById(workRegNo)
                .orElseThrow(() ->
                    new RuntimeException(
                        "Work details not found with work registration number: "
                        + workRegNo
                    )
                );
    }

    @Override
    public List<WorkDetails> getAllWorkDetails() {
        return workRepository.findAll();
    }

    @Override
    public WorkDetails updateWorkDetails(Long workRegNo, WorkDetails workDetails) {

        WorkDetails existingWork =
                workRepository.findById(workRegNo)
                .orElseThrow(() -> new RuntimeException( "Work details not found with work registration number: "+ workRegNo ));

        existingWork.setWorkDetails(workDetails.getWorkDetails());

        existingWork.setActualStartDate(workDetails.getActualStartDate());

        existingWork.setContractorName(workDetails.getContractorName());

        existingWork.setStipulatedStartDate(workDetails.getStipulatedStartDate());

        existingWork.setStipulatedEndDate(workDetails.getStipulatedEndDate());

        return workRepository.save(existingWork);
    }

    @Override
    public void deleteWorkDetails(Long workRegNo) {

        if (!workRepository.existsById(workRegNo)) {throw new RuntimeException("Work details not found with work registration number: "+ workRegNo);}

        workRepository.deleteById(workRegNo);
    }
}