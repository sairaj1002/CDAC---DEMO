package com.cdac.froms;

import java.time.LocalDate;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import jakarta.validation.constraints.NotNull;
import lombok.AllArgsConstructor;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.Setter;

@Entity
@Table(name = "works_details")
@Getter
@Setter
@NoArgsConstructor
@AllArgsConstructor
public class WorkDetails extends AuditableBaseClass {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "work_reg_no", nullable = false)
    private Long workRegNo;

    @Column(name = "work_details")
    @NotNull
    private String workDetails;

    @Column(name = "actual_start_date")
    @NotNull
    private LocalDate actualStartDate;

    @Column(name = "contractor_name")
    @NotNull
    private String contractorName;

    @Column(name = "stipulated_start_date")
    @NotNull
    private LocalDate stipulatedStartDate;

    @Column(name = "stipulated_end_date")
    @NotNull
    private LocalDate stipulatedEndDate;
}