package com.cdac.entities;

import java.time.LocalDate;

import org.hibernate.envers.Audited;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import jakarta.validation.constraints.NotNull;
import lombok.AllArgsConstructor;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.Setter;

@Entity
@Table(name = "works_details")
@Audited
@Getter
@Setter
@NoArgsConstructor
@AllArgsConstructor
public class WorkDetails extends AuditableBaseClass {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "work_reg_no", nullable = false, updatable = false)
    private Long workRegNo;

    @NotBlank(message = "Work details are required")
    @Size(max = 500, message = "Work details cannot exceed 500 characters")
    @Column(name = "work_details", nullable = false, length = 500)
    private String workDetails;

    @NotNull(message = "Actual start date is required")
    @Column(name = "actual_start_date", nullable = false)
    private LocalDate actualStartDate;

    @NotBlank(message = "Contractor name is required")
    @Size(max = 150, message = "Contractor name cannot exceed 150 characters")
    @Column(name = "contractor_name", nullable = false, length = 150)
    private String contractorName;

    @NotNull(message = "Stipulated start date is required")
    @Column(name = "stipulated_start_date", nullable = false)
    private LocalDate stipulatedStartDate;

    @NotNull(message = "Stipulated end date is required")
    @Column(name = "stipulated_end_date", nullable = false)
    private LocalDate stipulatedEndDate;
}