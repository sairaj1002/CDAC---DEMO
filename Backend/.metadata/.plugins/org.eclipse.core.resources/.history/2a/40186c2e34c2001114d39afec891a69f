package com.cdac.forms;

import lombok.*;

import java.time.LocalDate;

import org.hibernate.annotations.Audited;

import jakarta.persistence.*;

@Table(name= "works_details")
@Entity
@Audited
public class Work_Details {
	@Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
	@Column(nullable = false)
	public long workRegNo;
	
	public String work;
	
	public String work_details;
	
	public LocalDate actual_Start_Date;
	
	public String contractor_name;
	
	public String stipulated_Start_date;
	
	public String stipulated_end_date;
}





  