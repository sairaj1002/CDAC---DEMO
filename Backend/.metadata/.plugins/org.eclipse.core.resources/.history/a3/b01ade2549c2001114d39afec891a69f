package com.cdac.controller;

import java.util.List;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import com.cdac.froms.WorkDetails;
import com.cdac.service.WorkService;

@RestController
@RequestMapping("/api/work")
public class WorkController {

    private final WorkService workService;

    public WorkController(WorkService workService) {
        this.workService = workService;
    }

    // CREATE
    @PostMapping
    public ResponseEntity<WorkDetails> createWorkDetails(
            @RequestBody WorkDetails workDetails) {

        WorkDetails createdWork =
                workService.createWorkDetails(workDetails);

        return new ResponseEntity<>(
                createdWork,
                HttpStatus.CREATED
        );
    }

    // READ - Get all
    @GetMapping
    public ResponseEntity<List<WorkDetails>> getAllWorkDetails() {

        List<WorkDetails> workDetails =
                workService.getAllWorkDetails();

        return ResponseEntity.ok(workDetails);
    }

    // READ - Get by Work Registration Number
    @GetMapping("/{workRegNo}")
    public ResponseEntity<WorkDetails> getWorkDetailsByWorkRegNo(
            @PathVariable Long workRegNo) {

        WorkDetails workDetails =
                workService.getWorkDetailsByWorkRegNo(workRegNo);

        return ResponseEntity.ok(workDetails);
    }

    // UPDATE
    @PutMapping("/{workRegNo}")
    public ResponseEntity<WorkDetails> updateWorkDetails(
            @PathVariable Long workRegNo,
            @RequestBody WorkDetails workDetails) {

        WorkDetails updatedWork =
                workService.updateWorkDetails(
                        workRegNo,
                        workDetails
                );

        return ResponseEntity.ok(updatedWork);
    }

    // DELETE
    @DeleteMapping("/{workRegNo}")
    public ResponseEntity<Void> deleteWorkDetails(
            @PathVariable Long workRegNo) {

        workService.deleteWorkDetails(workRegNo);

        return ResponseEntity.noContent().build();
    }
}